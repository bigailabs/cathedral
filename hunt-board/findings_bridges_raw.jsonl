{"protocol": "polkadot_xcm", "file": "polkadot/xcm/xcm-builder/src/weight.rs", "lines": "FixedRateOfFungible::buy_weight fee formula", "source_url": "https://raw.githubusercontent.com/paritytech/polkadot-sdk/master/polkadot/xcm/xcm-builder/src/weight.rs", "invariant": "fee_monotone_in_weight", "result": "unsat", "status": "CLEAN", "class": "monotonicity", "witness": null, "notes": "Fee must be monotone: if (rt1,ps1) <= (rt2,ps2) componentwise, fee1 <= fee2. Required for refund safety."}
{"protocol": "polkadot_xcm", "file": "polkadot/xcm/xcm-builder/src/weight.rs", "lines": "FixedRateOfFungible::buy_weight / refund_weight", "source_url": "https://raw.githubusercontent.com/paritytech/polkadot-sdk/master/polkadot/xcm/xcm-builder/src/weight.rs", "invariant": "refund_leq_charge_conservation", "result": "unsat", "status": "CLEAN", "class": "conservation", "witness": null, "notes": "refund(w_r) <= charge(w_t) when w_r <= w_t. Direct conservation."}
{"protocol": "polkadot_xcm", "file": "polkadot/xcm/xcm-builder/src/weight.rs", "lines": "FixedRateOfFungible::buy_weight fee formula", "source_url": "https://raw.githubusercontent.com/paritytech/polkadot-sdk/master/polkadot/xcm/xcm-builder/src/weight.rs", "invariant": "rounding_split_leq_combined", "result": "unsat", "status": "CLEAN", "class": "rounding", "witness": null, "notes": "SHARP: floor(a/n)+floor(b/n) <= floor((a+b)/n)? If SAT, paying in splits is MORE expensive than single payment."}
{"protocol": "polkadot_xcm", "file": "polkadot/xcm/xcm-builder/src/weight.rs", "lines": "FixedRateOfFungible::buy_weight fee formula", "source_url": "https://raw.githubusercontent.com/paritytech/polkadot-sdk/master/polkadot/xcm/xcm-builder/src/weight.rs", "invariant": "combined_geq_split_by_floor_property", "result": "unsat", "status": "CLEAN", "class": "rounding", "witness": null, "notes": "floor((a+b)/n) >= floor(a/n)+floor(b/n) \u2014 combined buy >= split. Verifies floor-add property."}
