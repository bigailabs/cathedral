# Cathedral v4 thin publisher — environment.
# Copy to .env (or set in Railway service variables). NEVER commit the real
# signing key or production seed secrets.

# === REQUIRED FOR PRODUCTION (the one button only Fred presses) ===============
# The 32-byte Ed25519 signing key as HEX (64 hex chars). This MUST be the SAME
# production key the live monolith uses — its public key is
#   10890a66aa752479cb3b634f366d7bd27c374324d83f88d2d6b69ab066f25e26
# (jwks kid `cathedral-eval-signing`). Validators pin that pubkey; if this env
# is wrong/absent the publisher mints a throwaway dev key and EVERY validator
# signature check fails. Leave UNSET in staging (a fresh dev key is fine there).
CATHEDRAL_EVAL_SIGNING_KEY=

# === STORAGE =================================================================
# SQLite path. Put it on a persistent Railway volume so the seeded feed +
# minted challenges survive restarts.
CATHEDRAL_DB_PATH=/app/data/publisher.db

# === MINER SUBMIT RATE LIMIT ================================================
# Min seconds between submits per (hotkey, challenge). 0 = off (matches live's
# permissive default). Raise under abuse.
CATHEDRAL_SUBMIT_MIN_INTERVAL_SECS=0

# === G2 CHALLENGE REFILL LOOP ===============================================
# Turn ON only on the service that should MINT challenges. For the production
# launch publisher this should be true; for a pure mirror/shadow service set it
# false and let the seeder mirror the live board instead.
CATHEDRAL_REFILL_ENABLED=true
# Seconds between refill+retire passes.
CATHEDRAL_REFILL_INTERVAL_SECONDS=20
# Mint burst/queue defaults are intentionally modest: enough to keep the board
# above the active floor without turning refill into the whole workload.
CATHEDRAL_REFILL_MAX_MINTS=4
CATHEDRAL_PREGEN_QUEUE_SIZE=8
# Active-challenge targets per tier (live board = 25 / 25).
CATHEDRAL_REFILL_TARGET_T1=25
CATHEDRAL_REFILL_TARGET_T2=25
CATHEDRAL_REFILL_METHOD_T1=biased
CATHEDRAL_REFILL_METHOD_T2=ajm
# Live shape is n=6000, m=25560 (gens in ~2s). ONLY set these to fall back to a
# smaller instance if gen is too slow on the host (documented divergence).
# CATHEDRAL_REFILL_NVARS_T1=6000
# CATHEDRAL_REFILL_NCLAUSES_T1=25560

# Optional external SAT generator service. Leave disabled to use the local
# publisher refill generator. When enabled, refill leases CNFs from the external
# service and confirms the exact SHA it publishes to the board.
CATHEDRAL_SAT_GENERATOR_ENABLED=false
CATHEDRAL_SAT_GENERATOR_URL=
CATHEDRAL_SAT_GENERATOR_TOKEN=
CATHEDRAL_SAT_GENERATOR_MAX_MINTS=25
CATHEDRAL_SAT_GENERATOR_KIND_T1=random_3sat
CATHEDRAL_SAT_GENERATOR_KIND_T2=random_3sat
CATHEDRAL_SAT_GENERATOR_TIMEOUT_SECONDS=20
# Keep false in production unless local fallback is an explicit operator choice.
CATHEDRAL_SAT_GENERATOR_LOCAL_FALLBACK=false

# Stable server-side seed secret for locally minted and per-miner CNFs. Required
# in production so challenge IDs do not reveal solve seeds and restarts keep the
# same private assignment stream. Optional overrides can split the two lanes.
CATHEDRAL_PUBLISHER_SEED_SECRET=
CATHEDRAL_REFILL_SEED_SECRET=
CATHEDRAL_PERMINER_SEED_SECRET=

# === RETIREMENT (live v6 open-window thresholds) ============================
# Age-based retirement: retire an active challenge after this many seconds.
CATHEDRAL_OPEN_WINDOW_RETIRE_AFTER_SECONDS=3600
# Solved-based retirement: retire after this many DISTINCT solver hotkeys.
CATHEDRAL_OPEN_WINDOW_RETIRE_AFTER_DISTINCT_SOLVERS=256

# === SERVER =================================================================
# Railway injects PORT; set only for local runs.
# PORT=8000
