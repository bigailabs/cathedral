# Cathedral V2 relaunch env example.
# Keep this file boring. The full inventory lives in deploy/ENV_SURFACE.md.
# Audit any real env file with:
#   python3 deploy/check_env_surface.py --env-file /path/to/env

# === Shared core: every origin/worker process =================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
CATHEDRAL_LAUNCH_PROFILE=v2-converged

# Validators pin this signing identity. Do not rotate casually.
CATHEDRAL_EVAL_SIGNING_KEY=<64-hex-ed25519-private-key>

# Stable secrets. These must be identical across every process in the deployment.
CATHEDRAL_V2_SUBMIT_TOKEN_SECRET=<stable-hmac-secret>
CATHEDRAL_PERMINER_SEED_SECRET=<stable-perminer-seed>
CATHEDRAL_CNF_TOKEN_SECRET=<stable-legacy-cnf-token-secret>

# Identity and query guardrails that materially affect launch safety.
CATHEDRAL_WEIGHTS_COLDKEY_COLLAPSE=1
CATHEDRAL_PG_STATEMENT_TIMEOUT_MS=4000

# Conservative V2 read/submit/verify concurrency. Raise only after live evidence.
CATHEDRAL_PM_READ_HARD_CAP=4
CATHEDRAL_V2_READ_THREADS=4
CATHEDRAL_V2_SUBMIT_BITSET_THREADS=4
CATHEDRAL_V2_VERIFY_BATCH_SIZE=8
CATHEDRAL_V2_VERIFY_INTERVAL_SECS=1
CATHEDRAL_V2_VERIFY_LOCK_SECS=120

# === Process-local role: set one pair per service =============================
# Public read origin: serves miner/validator routes; verifier stays off.
CATHEDRAL_SERVICE_ROLE=all
CATHEDRAL_V2_VERIFY_WORKER_ENABLED=0

# Private verifier process overlay:
# CATHEDRAL_SERVICE_ROLE=all
# CATHEDRAL_V2_VERIFY_WORKER_ENABLED=1

# === Mechanism calibration: leave default unless intentionally changing SAT ====
CATHEDRAL_PERMINER_EPOCH_BUCKET_HOURS=1
CATHEDRAL_PERMINER_ALLOTMENT_T1=10000
CATHEDRAL_PERMINER_ALLOTMENT_T2=10000
CATHEDRAL_PERMINER_NVARS_T1=400
CATHEDRAL_PERMINER_NCLAUSES_T1=1704
CATHEDRAL_PERMINER_WEIGHT_T1=1.0
CATHEDRAL_PERMINER_WEIGHT_T2=2.0
CATHEDRAL_PERMINER_MAX_PAGE_LIMIT=10
CATHEDRAL_V2_REAL_FRACTION=0

# === Optional operator/admin surface ==========================================
# CATHEDRAL_PUBLISHER_ADMIN_TOKEN=<operator-only-token>
# CATHEDRAL_V2_ADMIN_TOKEN=<operator-only-token>
# CATHEDRAL_WEIGHT_POLICY_KEY_ID=cathedral-weight-policy
# CATHEDRAL_WEIGHT_POLICY_NETWORK=finney
# CATHEDRAL_WEIGHT_POLICY_NETUID=39

# === Do not set for relaunch ==================================================
# The launch profile implies these; explicit values just create contradictions:
# CATHEDRAL_V2_ENABLED
# CATHEDRAL_V2_SUBMIT_BITSET_ENABLED
# CATHEDRAL_V2_LAZY_ISSUANCE
# CATHEDRAL_V2_PM_PAYOUT_BRIDGE
# CATHEDRAL_V2_PERMINER_ENABLED
#
# Split V2 stores make verified bitset payouts invisible to scoring:
# CATHEDRAL_V2_DATABASE_URL
# CATHEDRAL_V2_DB_PATH
#
# V1 per-miner route flag. The edge retires V1 miner paths; leave unset:
# CATHEDRAL_PERMINER_ENABLED
