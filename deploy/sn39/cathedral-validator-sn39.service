[Unit]
Description=Cathedral SN39 validated Intel TDX CPU validator
After=network-online.target
Wants=network-online.target
Conflicts=cathedral-thin-validator.service cathedral-validator-sn39-launch.service
ConditionPathIsReadWrite=/var/lib/cathedral-validator

[Service]
Type=simple
User=cathedral-validator
Group=cathedral-validator
Environment=HOME=/var/lib/cathedral-validator
ExecStart=/usr/bin/python3 -I -E -s /usr/local/libexec/cathedral-sn39-release continuous
Restart=on-failure
RestartSec=15s
TimeoutStopSec=30s
StateDirectory=cathedral-validator
StateDirectoryMode=0700
LogsDirectory=cathedral-validator
LogsDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cathedral-validator /var/log/cathedral-validator
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
