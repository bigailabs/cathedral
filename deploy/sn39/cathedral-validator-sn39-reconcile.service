[Unit]
Description=Cathedral SN39 finalized launch reconciliation
After=network-online.target cathedral-validator-sn39-launch.service cathedral-thin-validator.service cathedral-confidential-validator-sn39.service cathedral-confidential-validator.service cathedral-validator.service
Wants=network-online.target
Conflicts=cathedral-thin-validator.service cathedral-validator-sn39.service cathedral-confidential-validator-sn39.service cathedral-confidential-validator.service cathedral-validator.service

[Service]
Type=oneshot
User=cathedral-validator
Group=cathedral-validator
Environment=HOME=/var/lib/cathedral-validator
# Belt and braces. Conflicts= only acts on units systemd is asked to start;
# it cannot stop a writer someone launched by hand. This refuses to start
# at all while any known SN39 writer is active, because the legacy writer
# uses its own state file and runtime root and therefore shares no
# cross-process submission lock with this unit. Two writers on one hotkey
# means nonce races and a second weight extrinsic.
ExecStartPre=/bin/sh -c '! systemctl is-active --quiet cathedral-confidential-validator-sn39.service cathedral-confidential-validator.service cathedral-validator.service'
ExecStart=/usr/bin/python3 -I -E -s /usr/local/libexec/cathedral-sn39-release reconcile
TimeoutStartSec=5min
StateDirectory=cathedral-validator
StateDirectoryMode=0700
LogsDirectory=cathedral-validator
LogsDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cathedral-validator /var/log/cathedral-validator
RestrictSUIDSGID=true
LockPersonality=true
