[Unit]
Description=Publish sanitized Cathedral SN39 validator status
After=cathedral-validator-sn39.service
ConditionPathExists=/var/log/cathedral-validator/validator-events.jsonl

[Service]
Type=oneshot
User=cathedral-status
Group=cathedral-status
SupplementaryGroups=cathedral-validator
ExecStart=/usr/bin/python3 -I -E -s /usr/local/libexec/cathedral-sn39-release status
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/var/log/cathedral-validator/validator-events.jsonl
ReadOnlyPaths=/var/lib/cathedral-public-evidence/index.json
ReadOnlyPaths=/var/lib/cathedral-public-evidence/release.json
ReadWritePaths=/var/lib/cathedral-public-evidence/logs
