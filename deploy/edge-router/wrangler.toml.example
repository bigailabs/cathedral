name = "cathedral-edge-router"
main = "worker.mjs"
compatibility_date = "2026-06-25"
workers_dev = true
preview_urls = true

# Route intentionally left commented. Enable only after smoke checks pass. Use
# exact hot-path routes; do not start with api.cathedral.computer/* or
# /v1/synthetic-boolean/* because non-SAT/compute/readiness endpoints may still
# live on the monolith.
# routes = [
#   { pattern = "api.cathedral.computer/v1/synthetic-boolean/active-challenges*", zone_name = "cathedral.computer" },
#   { pattern = "api.cathedral.computer/v1/synthetic-boolean/active-cnf*", zone_name = "cathedral.computer" },
#   { pattern = "api.cathedral.computer/v1/synthetic-boolean/per-miner/challenges*", zone_name = "cathedral.computer" },
#   { pattern = "api.cathedral.computer/v1/synthetic-boolean/per-miner/cnf*", zone_name = "cathedral.computer" },
#   { pattern = "api.cathedral.computer/v1/agents/submit*", zone_name = "cathedral.computer" },
#   { pattern = "submit.cathedral.computer/v1/agents/submit*", zone_name = "cathedral.computer" },
#   { pattern = "api.cathedral.computer/v1/leaderboard/recent*", zone_name = "cathedral.computer" },
#   { pattern = "api.cathedral.computer/v1/leaderboard/top*", zone_name = "cathedral.computer" },
#   { pattern = "api.cathedral.computer/v1/leaderboard/explain*", zone_name = "cathedral.computer" },
#   { pattern = "api.cathedral.computer/v1/validator/weights/next*", zone_name = "cathedral.computer" },
#   { pattern = "api.cathedral.computer/.well-known/*", zone_name = "cathedral.computer" },
#   { pattern = "api.cathedral.computer/health*", zone_name = "cathedral.computer" },
# ]

[vars]
READ_ORIGIN = "https://read.cathedral.computer"
# Optional provider-origin routing knobs.
# READ_ORIGIN_HOST = "api.cathedral.computer"
# READ_ORIGIN_RESOLVE_OVERRIDE = "origin.example.com"
# If routing submit.cathedral.computer through this Worker, set SUBMIT_ORIGIN
# to the direct provider origin, not submit.cathedral.computer, to avoid loops.
SUBMIT_ORIGIN = "https://cathedral-submit-production.up.railway.app"
READ_ORIGIN_TIMEOUT_MS = "10000"

# Default-off optional V1 submit shadow mirror.
SHADOW_V1_MIRROR_ENABLED = "false"
SHADOW_V1_MIRROR_ORIGIN = "https://v2-beta.cathedral.computer"
# full = forward full V1 body to V2 shadow; meta = drop dimacs_solution and send tiny metadata only.
SHADOW_V1_MIRROR_MODE = "meta"
SHADOW_V1_MIRROR_SAMPLE_PERCENT = "0.1"
SHADOW_V1_MIRROR_TIMEOUT_MS = "1000"
SHADOW_V1_MIRROR_SOURCE = "edge-mirror-v1-0p1pct"
